# A view a routine value read out of a global gives back carries the sources of the views it was handed.

import Hosted

### Gives the second.
### :param a: One.
### :param b: Two.
### :returns: The second.
routine second(a: @S64, b: @S64) -> @S64
    return b

global PICK: &Callable[(@S64, @S64), @S64] <- second.to[Callable]()

### Through a routine value read from a global.
routine start() -> None
    a: &S64 <- 1 from HEAP
    b: &S64 <- 2 from HEAP
    f: Callable[(@S64, @S64), @S64] = PICK.load()
    r: @S64 = f.call(a, b)
    drop b
    Console.show("{r.peek()}")
    drop a
    return
