# The view of an access is used only while the access is held: a write through it after the give-back is a build
# error, since another thread may be changing that value by then.

import Hosted

global COUNTER: &U64

routine start() -> None
    held: @U64 <- COUNTER.get_exclusive_access()
    held.poke(1)
    drop held
    held.poke(2)
    return
