# Tickets whose work was lent a run's shared read access go in a List[Thread[S64]] and are retrieved together. Each
# work is lent one of two named accesses, given back once the work is over.

import Collections
import Hosted

### The sum of the values the access covers.
### :param part: The shared read access to the values.
### :returns: Their sum.
routine total(part: %[S64]) -> S64
    view: %[S64] = part

    for i in 0 til view.count() with sum: S64 = 0
        continue with sum: sum + view[i]
    then
        return sum

### Sums each half of four numbers on a thread of its own.
routine start() -> None
    numbers: &[S64] <- [1, 2, 3, 4] * 1 from HEAP
    ts: &List[Thread[S64]] <- .construct(HEAP)
    view: @[S64] = numbers.getslice()
    low: %[S64] <- view.getslice(start: 0, count: 2).get_shared_read_access()
    high: %[S64] <- view.getslice(start: 2, count: 2).get_shared_read_access()

    first: Thread[S64] <- get_thread[S64]()
    on_low: Work[S64] = total.to[Work](part: low)
    first.put_work(steal on_low)
    ts.add_last(steal first)
    second: Thread[S64] <- get_thread[S64]()
    on_high: Work[S64] = total.to[Work](part: high)
    second.put_work(steal on_high)
    ts.add_last(steal second)
    sums: &List[S64] <- ts.retrieve_all()
    ts.give_back_all()
    drop low
    drop high
    Console.show("{sums[0]} {sums[1]}")
    drop numbers
    return
