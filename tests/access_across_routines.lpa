# An access is followed across routines: a routine may take one and return it (the caller takes it with '<-' and gives
# it back), and a routine handed the view only works through it (its drop of the view ends that reference alone).

import Hosted

global COUNTER: &U64

### Takes exclusive access to the counter and hands it to the caller.
### :returns: The access.
routine open_counter() -> @U64
    return COUNTER.get_exclusive_access()

### Adds one through the view of the access, and drops the view (the caller still holds the access).
### :param held: The view of an exclusive access the caller holds.
routine bump(held: @U64) -> None
    view: @U64 = held
    view.poke(view.peek() + 1)
    drop held
    return

routine start() -> None
    held: @U64 <- open_counter()
    bump(held)
    drop held
    again: @U64 <- open_counter()
    view: @U64 = again
    view.poke(view.peek() + 1)
    drop again
    Console.show("{COUNTER.load()}, held: {AccessManager.held_count()}")
    return
