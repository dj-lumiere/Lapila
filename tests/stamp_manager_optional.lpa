# A Stamped[T]? is the stamp itself, an address and a U64 generation: the all-zero stamp is None. when, try,
# is_absent, unwrap and a field of that type work as on any Optional.

import Hosted

### A node with a link that may be missing.
entity Node
    value: S64
    next: Stamped[Node]?

### Makes a node.
### :param value: Its value.
### :param next: The node after it, if any.
### :returns: The node.
common routine Node.construct(value: S64, next: Stamped[Me]?) -> Me
    return Me(value, next)

### What a link names: its value, -1 for none, -2 for an ended node.
### :param link: The link.
### :returns: The value.
routine describe(link: Stamped[Node]?) -> S64
    when link
        is Stamped[Node] as s =>
            when try s.fetch()
                is @Node as n => return n.value.peek()
                is None => return -2
        is None => return -1

### Shows the layout and the four ways to read it.
routine start() -> None
    pool: &StampManager[Node] <- .construct(manager: HEAP)
    stamp_size: U64 = sizeof[Stamped[Node]]()
    # An address and a U64, with at most the padding that aligns the U64.
    fits: Bool = sizeof[Addr]() + sizeof[U64]() <= stamp_size <= 2 * sizeof[U64]()
    Console.show("sizes: {fits} {sizeof[Stamped[Node]?]() == stamp_size}")
    last: Stamped[Node] = pool.add(Node.construct(value: 3, next: none))
    first: Stamped[Node] = pool.add(Node.construct(value: 1, next: last))
    missing: Stamped[Node]? = none
    some: Stamped[Node]? = first
    Console.show("describe: {describe(missing)} {describe(some)} {describe(first.fetch().next.peek())}")
    Console.show("absent: {missing.is_absent()} {some.is_absent()} {first.fetch().next.peek().is_absent()} {last.fetch().next.peek().is_absent()}")
    Console.show("same: {some.unwrap() === first}")
    via_try: S64 = when try some.unwrap().fetch()
        is @Node as n => n.value.peek()
        is None => -9
    Console.show("try: {via_try}")
    pool.remove(last)
    Console.show("after remove: {describe(first.fetch().next.peek())}")
    drop pool
    return
