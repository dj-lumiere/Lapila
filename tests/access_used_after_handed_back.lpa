# Only the name that took an access gives it back: handing it over with steal is a build error.

import Hosted

global COUNTER: &U64

### Gives the access back.
### :param held: An exclusive access.
routine close(held: @U64) -> None
    drop held
    return

routine start() -> None
    held: @U64 <- COUNTER.get_exclusive_access()
    close(steal held)
    held.poke(4)
    return
