# An access handed over with steal is the taker's: the name it was taken in is used no more.

import Hosted

global COUNTER: &U64

### Takes the access over.
### :param held: The access, handed over.
routine close(held: @U64) -> None
    return

### Uses the name after handing the access over.
routine start() -> None
    held: @U64 <- COUNTER.get_exclusive_access()
    close(steal held)
    held.poke(4)
    return
