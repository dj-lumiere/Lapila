# Recursive and loop-based Fibonacci, printed one character at a time.

import Hosted

### Writes one character to standard output.
### :param code: The character's code, below 128.
routine put_code(code: U64) -> None
    cell: &Byte <- bitcast[U8, Byte](code.to[U8]())

    Console.output().write_bytes(data: cell, count: 1)
    return

### Prints n in decimal: digits above the last one first, by recursion.
routine print_decimal(n: U64) -> None
    if n >= 10
        rest: U64 = n // 10
        print_decimal(rest)
    digit: U64 = n % 10
    ch: U64 = digit + Byte('0').to[U8]().to[U64]()
    put_code(ch)
    return

routine println_decimal(n: U64) -> None
    print_decimal(n)
    put_code(10)
    return

routine fib_rec(n: U64) -> U64
    if n < 2
        return n
    else
        a: U64 = fib_rec(n - 1)
        b: U64 = fib_rec(n - 2)
        return a + b

routine fib_loop(n: U64) -> U64
    a: &U64 <- 0
    b: &U64 <- 1

    for i in 0 til n
        next: U64 = a.load() + b.load()
        next_b: U64 = next
        next_a: U64 = b.load()
        next_a.poke_into(a)
        next_b.poke_into(b)
    then
        return a.load()

routine start() -> None
    println_decimal(fib_rec(10))
    println_decimal(fib_loop(20))
    println_decimal(fib_loop(90))
    return
