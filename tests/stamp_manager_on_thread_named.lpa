# A routine value the build can name is followed to its routine: the work calls it, and the routine uses the pool.

import Hosted

### Makes a pool and ends it.
### :param n: Unused.
routine tidy(n: S64) -> None
    pool: &StampManager <- .construct(manager: HEAP)
    return

### The work.
routine run() -> None
    f: Callable[(S64,), None] = tidy.to[Callable[(S64,), None]]()
    f.call(1)
    return

routine start() -> None
    pool: &StampManager <- .construct(manager: HEAP)
    t: Thread[None] <- get_thread[None]()
    w: Work[None] = run.to[Work]()
    t.put_work(w)
    t.retrieve()
    drop t
    drop pool
    return
