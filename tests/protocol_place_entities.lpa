### Protocol places that hold entities: a list mixing two entity types (one from HEAP, one from STACK), a member
### variable, an optional place, a result, a view parameter, a generic routine given a stored value, and `when ... is`.
### Each entity ends once, when the place that holds it ends.
import Collections
import Hosted

entity Slime
obeys Enemy[Slime]
    hp: S64

entity Goblin
obeys Enemy[Goblin]
    hp: S64
    name: @[Byte]

entity Arena
    boss: Enemy
    spare: Enemy?

### Something that moves each turn.
### :typeparam T: The enemy type.
protocol Enemy[T]
    ### Moves one step.
    routine @Me.update() -> None

    ### The hit points left.
    ### :returns: The hit points.
    routine @Me.health() -> S64

### A slime.
### :param hp: The hit points.
### :returns: The slime.
common routine Slime.construct(hp: S64) -> Me
    return Me(hp: hp)

### Moves the slime.
routine @Slime.update() -> None
    Console.show("slime {me.hp.peek()} oozes")
    return

### The slime's hit points.
### :returns: The hit points.
routine @Slime.health() -> S64
    return me.hp.peek()

### Ends the slime.
routine @Slime.destruct() -> None
    Console.show("slime {me.hp.peek()} ends")
    return

### A goblin.
### :param hp: The hit points.
### :param name: The goblin's name.
### :returns: The goblin.
common routine Goblin.construct(hp: S64, name: @[Byte]) -> Me
    return Me(hp: hp, name: name)

### Moves the goblin.
routine @Goblin.update() -> None
    Console.show("goblin {me.name.peek()} runs")
    return

### The goblin's hit points.
### :returns: The hit points.
routine @Goblin.health() -> S64
    return me.hp.peek()

### Ends the goblin.
routine @Goblin.destruct() -> None
    Console.show("goblin {me.name.peek()} ends")
    return

### An arena with its boss.
### :param boss: The boss, taken over.
### :returns: The arena.
common routine Arena.construct(boss: Enemy) -> Me
    return Me(boss: steal boss, spare: None())

### A goblin from the heap, as a stored Enemy.
### :returns: The enemy.
routine make_boss() -> Enemy
    boss: &Goblin <- .construct(hp: 40, name: "Grak") from HEAP
    return steal boss

### Says what an enemy is.
### :param e: The enemy.
routine describe(e: @Enemy) -> None
    when e
        is Slime as s => Console.show("a slime with {s.hp.peek()} hp")
        is Goblin as g => Console.show("a goblin called {g.name.peek()}")
        else => Console.show("something else")
    return

### Runs two turns of any enemy, built for the type it is given.
### :typeparam T: The enemy's type.
### :param e: The enemy.
routine two_turns[T](e: @T) -> None
needs T obeys Enemy
    e.update()
    e.update()
    return

routine start() -> None
    enemies: &List[Enemy] <- .construct(HEAP)
    slime: &Slime <- .construct(hp: 3) from HEAP
    enemies.add_last(steal slime)
    goblin: &Goblin <- .construct(hp: 12, name: "Nim")
    enemies.add_last(steal goblin)
    for i in 0 til enemies.count()
        enemies.getslot(i).update()
        describe(enemies.getslot(i))
        Console.show("health {enemies.getslot(i).health()}")
    two_turns(enemies.getslot(0))
    arena: &Arena <- .construct(boss: make_boss())
    arena.boss.update()
    describe(arena.boss)
    other: &Slime <- .construct(hp: 5) from HEAP
    maybe: &(Enemy?) <- steal other
    when steal maybe
        is Enemy as found => describe(found)
        is None => Console.show("no enemy")
    drop enemies
    Console.show("the end")
    return
