# Work retrieved on one branch only still runs on the other when start returns: a build error.

import Hosted

routine seven() -> S64
    return 7

routine start() -> None
    t: Thread[S64] <- get_thread[S64]()
    work: Work[S64] = seven.to[Work]()
    t.put_work(work)
    if seven() > 5
        Console.show("{t.retrieve()}")
    return
