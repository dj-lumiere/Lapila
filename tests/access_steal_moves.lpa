# An access moves with steal to a new '<-' name and out of a routine with return steal: each place it lands gives it
# back once.

import Hosted

global COUNTER: &U64

### Takes the access and hands it to the caller.
### :returns: The access.
routine open_counter() -> @U64
    held: @U64 <- COUNTER.get_exclusive_access()
    moved: @U64 <- steal held
    moved.poke(moved.peek() + 1)
    return steal moved

### Moves an access between names.
routine start() -> None
    first: @U64 <- open_counter()
    kept: @U64 <- steal first
    kept.poke(kept.peek() + 1)
    Console.show("{kept.peek()}, held: {AccessManager.held_count()}")
    drop kept
    Console.show("held: {AccessManager.held_count()}")
    return
