# The access a routine returns is one the caller holds: the builder gives it back where the caller returns.

import Hosted

global COUNTER: &U64

### Takes exclusive access to the counter and hands it to the caller.
### :returns: The access.
routine open_counter() -> @U64
    return COUNTER.get_exclusive_access()

routine start() -> None
    held: @U64 <- open_counter()
    held.poke(3)
    Console.show("{held.peek()}")
    return
