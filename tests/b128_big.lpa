# B128Big, the 448-bit exact tier of B128's math functions (Standard/B128Big.lpa): each result's sign, exponent,
# and mantissa in hex. Every one was checked against mpmath to within 2^-430 relative.

import Hosted

routine show(name: @[Byte], v: B128Big) -> None
    m: &BigNat[16] <- v.mant

    count: U64 = m.count.peek()
    Console.output().write("{name} {v.negative.to[S32]()} {v.exponent} ")

    until left == 0 with left: U64 = count
        i: U64 = left - 1
        limb: U64 = m.limbs[i]
        write_hex(value: limb, digits: 16)
        continue with left: i
    Console.output().write("\n")
    return

routine f(x: B64) -> B128Big
    r: B128Big = B128.to[B128Big](x.to[B128]())
    return r

### Writes `value` in lowercase hex, zero-padded to `digits` digits.
### :param value: The value.
### :param digits: The fewest digits.
routine write_hex(value: U64, digits: U64) -> None
    out: @ConsoleOutput = Console.output()
    needed: U64 = hex_digits(value).max(digits)
    letters: @[Byte] = "0123456789abcdef"

    for i in 0 til needed
        nibble: U64 = (value >>> (4 * (needed - 1 - i))) & 15
        out.write_bytes(data: letters.data.stride(nibble), count: 1)
        continue
    return

### How many hex digits `value` takes, 1 for 0.
### :param value: The value.
### :returns: The count.
routine hex_digits(value: U64) -> U64
    until n == 16 or (value >>> (4 * n)) == 0 with n: U64 = 1
        continue with n: n + 1
    then
        return n

routine start() -> None
    show(name: "exp(1)", v: big_exp(f(1.0)))
    show(name: "exp(-100.3)", v: big_exp(f(-100.3)))
    show(name: "exp(11000.5)", v: big_exp(f(11000.5)))
    show(name: "expm1(2^-30)", v: big_exp_m1(f(0x1p-30)))
    show(name: "expm1(-0.001)", v: big_exp_m1(f(-0.001)))
    show(name: "ln(3)", v: big_ln(f(3.0)))
    show(name: "ln(1e-300)", v: big_ln(f(1e-300)))
    show(name: "ln(1+2^-40)", v: big_ln(f(1.0) + f(0x1p-40)))
    show(name: "ln(0.75)", v: big_ln(f(0.75)))
    show(name: "ln1p(0.3)", v: big_ln_1p(f(0.3)))
    show(name: "ln1p(-2^-25)", v: big_ln_1p(f(-0x1p-25)))
    show(name: "sin(0.7)", v: big_sin_core(f(0.7)))
    show(name: "cos(0.7)", v: big_cos_core(f(0.7)))
    show(name: "recip(3)", v: f(3.0).recip())
    show(name: "sqrt(2)", v: f(2.0).sqrt())
    show(name: "div(1,7)", v: f(1.0) / f(7.0))
    show(name: "sub", v: f(1.0) - f(0x1.fffffffffffffp-1))
    show(name: "theta(1e30)", v: big_reduce(B64.to[B128](1e30)).theta)
    show(name: "qtheta(1e30)",
        v: big_from_u128(negative: false, value: big_reduce(B64.to[B128](1e30)).quadrant.to[U128](), exponent: 0))
    e600: B128 = B64.to[B128](1e300) * B64.to[B128](1e300)
    e900: B128 = e600 * B64.to[B128](1e300)
    show(name: "theta(1e900)", v: big_reduce(e900).theta)
    show(name: "qtheta(1e900)",
        v: big_from_u128(negative: false, value: big_reduce(e900).quadrant.to[U128](), exponent: 0))
    show(name: "theta(MAX)", v: big_reduce(B128.MAX).theta)
    show(name: "qtheta(MAX)",
        v: big_from_u128(negative: false, value: big_reduce(B128.MAX).quadrant.to[U128](), exponent: 0))
    show(name: "theta(2.5)", v: big_reduce(B64.to[B128](2.5)).theta)
    show(name: "qtheta(2.5)",
        v: big_from_u128(negative: false, value: big_reduce(B64.to[B128](2.5)).quadrant.to[U128](), exponent: 0))
    show(name: "theta(0.3)", v: big_reduce(B64.to[B128](0.3)).theta)
    show(name: "qtheta(0.3)",
        v: big_from_u128(negative: false, value: big_reduce(B64.to[B128](0.3)).quadrant.to[U128](), exponent: 0))
    return
