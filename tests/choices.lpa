# Choices: written and implicit member values, the default S32 underlying type, eq / ne, and switches that name every member
# instead of a '_' arm.

import Hosted

### Written values: every member has one.
choice Level: S8
    LOW: 0
    MID: 1
    HIGH: 10
    MAX: 11

### No underlying type: S32.
choice Shape: U8
    CIRCLE
    SQUARE

routine level_value(l: Level) -> S64
    raw: S8 = bitcast[Level, S8](l)
    wide: S64 = raw.to[S64]()
    return wide

### Every member is named, so no '_' arm is needed.
routine level_rank(l: Level) -> S64
    when l
        Level.LOW => return 1
        Level.MID => return 2
        Level.HIGH => return 3
        Level.MAX => return 4

routine shape_sides(s: Shape) -> S64
    if s == Shape.CIRCLE
        return 0
    else
        return 4

routine start() -> None
    Console.show("{level_value(Level.LOW)}")
    Console.show("{level_value(Level.MID)}")
    Console.show("{level_value(Level.HIGH)}")
    Console.show("{level_value(Level.MAX)}")
    Console.show("{level_rank(Level.HIGH)}")
    Console.show("{shape_sides(Shape.CIRCLE)}")
    Console.show("{shape_sides(Shape.SQUARE)}")
    l: Level = Level.MID
    same: Bool = l == Level.MID
    differs: Bool = l != Level.MID
    Console.show("{same.to[S64]()}")
    Console.show("{differs.to[S64]()}")
    return
