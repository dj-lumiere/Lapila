# A stamp fetched after its pool has ended is a stale stamp (received with try), two pools live side by side, a pool
# made after one ended doesn't read the old pool's entities through its stamps, and a stamp is refused by a pool it
# wasn't added to.

import Hosted

### A node that keeps a value.
entity Node
    value: S64

### Makes a node.
### :param value: Its value.
### :returns: The node.
common routine Node.construct(value: S64) -> Me
    return Me(value)

### What a stamp fetches now: the value, or -1 when it fails.
### :param s: The stamp.
### :returns: The value or -1.
routine value_of(s: Stamped[Node]) -> S64
    when try s.fetch()
        is @Node as n => return n.value.peek()
        is None => return -1

### Whether a pool takes a stamp to remove.
### :param pool: The pool.
### :param s: The stamp.
### :returns: True when it removed the entity.
routine removed(pool: @StampManager, s: Stamped[Node]) -> Bool
    done: Bool = try pool.remove(s)
    return done

### Shows stamps across the end of a pool.
routine start() -> None
    pool: &StampManager <- .construct(manager: HEAP)
    other: &StampManager <- .construct(manager: HEAP)
    a: Stamped[Node] = pool.add(Node.construct(value: 1))
    b: Stamped[Node] = other.add(Node.construct(value: 2))
    Console.show("alive: {value_of(a)} {value_of(b)}, other pool takes a: {removed(other, a)}")
    drop pool
    Console.show("after the end: {value_of(a)} {value_of(b)}")
    again: &StampManager <- .construct(manager: HEAP)
    c: Stamped[Node] = again.add(Node.construct(value: 3))
    Console.show("new pool: {value_of(c)}, old stamp: {value_of(a)}, same: {a === c}")
    return
