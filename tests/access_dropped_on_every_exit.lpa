# An access is taken from the AccessManager and given back on every path: the path that returns early gives it back
# through the builder's drop at the exit, and a second bump takes it again without waiting for itself.

import Hosted

global COUNTER: &U64

routine bump(by: U64) -> None
    held: Authorized[U64] <- COUNTER.get_exclusive_access()
    if by == 0
        return
    held.getview().poke(held.getview().peek() + by)
    drop held
    return

routine start() -> None
    bump(0)
    bump(1)
    bump(2)
    Console.show("{COUNTER.load()}")
    return
