# A routine value bound to a name, called with a view and a list: the list holds a view of what was handed in.

import Collections
import Hosted

record Ops
    op: Callable[(@List[@S64], @S64), None]

### Gives the second.
### :param a: One.
### :param b: Two.
### :returns: The second.
routine second(a: @S64, b: @S64) -> @S64
    return b

### Keeps a view in a list.
### :param out: The list.
### :param v: The view.
routine keep_in(out: @List[@S64], v: @S64) -> None
    out.add_last(v)
    return

### A routine value bound to a name keeps a view in a list another argument reaches.
routine start() -> None

    xs: &List[@S64] <- List[@S64].construct(HEAP)
    b: &S64 <- 2 from HEAP
    f: Callable[(@List[@S64], @S64), None] = keep_in.to[Callable]()
    f.call(xs, b)
    drop b
    Console.show("{xs.getitem(0).peek()}")
    drop xs
    return
