# A view fetched through a stamp is used after a call that may end an entity of a pool (a routine that calls remove):
# the entity it was fetched from may have ended there, so this is a build error.

import Hosted

### A node that keeps a value.
entity Node
    value: S64

### Makes a node.
### :param value: Its value.
### :returns: The node.
common routine Node.construct(value: S64) -> Me
    return Me(value)

### Removes an entity from its pool.
### :param pool: The pool.
### :param s: The entity's stamp.
routine kill(pool: @StampManager, s: Stamped[Node]) -> None
    pool.remove(s)
    return

### Uses a fetched view after a remove.
routine start() -> None
    pool: &StampManager <- .construct(manager: HEAP)
    a: Stamped[Node] = pool.add(Node.construct(value: 1))
    b: Stamped[Node] = pool.add(Node.construct(value: 2))
    v: @Node = b.fetch()
    kill(pool, a)
    Console.show("{v.value.peek()}")
    return
