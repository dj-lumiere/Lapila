# A routine value read out of a field names no routine, so a call through it is taken to keep the view it is handed in the list it is handed.

import Hosted
import Collections

### Gives the second.
### :param a: One.
### :param b: Two.
### :returns: The second.
routine second(a: @S64, b: @S64) -> @S64
    return b

### Keeps a view in a list.
### :param out: The list.
### :param v: The view.
routine keep_in(out: @List[@S64], v: @S64) -> None
    out.add_last(v)
    return

record Ops
    op: Callable[(@List[@S64], @S64), None]

### A routine value read from a field keeps a view in a list another argument reaches.
routine start() -> None
    ops: &Ops <- Ops(op: keep_in.to[Callable]())
    xs: &List[@S64] <- List[@S64].construct(HEAP)
    b: &S64 <- 2 from HEAP
    f: Callable[(@List[@S64], @S64), None] = ops.op.peek()
    f.call(xs, b)
    drop b
    Console.show("{xs.getitem(0).peek()}")
    drop xs
    return
