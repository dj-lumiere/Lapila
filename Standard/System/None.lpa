# Lapila stdlib: None, the type with exactly one value
#
# Maps to the empty LLVM struct {} (zero size). Its one value is written none. It can be bound, passed, stored in
# fields and used as a generic argument. A routine with nothing to return returns None, it is the branch of
# Optional[T] that holds nothing, and Check[None] is what `check` gives for a failable routine that returns nothing.

module System

### The type with exactly one value, `none`, mapped to the empty LLVM struct `{}`. It can be bound, passed and stored, so it fills a generic slot that needs no payload, such as `Check[None]`.
record None
obeys Equatable[None], Hashable[None], Comparable[None]
    nothing

# -- equality, hashing ---------------------------------------------------------

### There is only one `None` value, so every pair is equal.
### :param other: The other `None`.
### :returns: Always `true`.
routine None.eq(other: Me) -> Bool
    return true

### Hashes the one `None` value. Every `None` hashes the same.
### :returns: A constant 64-bit hash.
routine None.hash() -> U64
    h: U64 = siphash24(value: 0, key: hash_key())
    return h

### None values are all equal.
### :param other: The value to compare with.
### :returns: Always 0.
routine None.compare(other: Me) -> S32
    return 0
