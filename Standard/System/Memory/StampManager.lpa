# Lapila stdlib: the StampManager and Stamped, entities of one type linked by stamps
#
# A `StampManager[T]` keeps entities of the one type T (a variant type keeps several kinds, `StampManager[Shape]`, and
# several types take several pools). A pool of a protocol, `StampManager[Enemy]`, keeps entities of every type that
# obeys it: its T is the protocol's stored value (the type id, the address of a `&T` and its manager), so each slot
# has the same size, the entity stays in its `&T`'s memory, and `pool.add(steal s)` takes a `&Slime` or a `&Goblin`. `pool.add(steal node)` hands an entity over, which the pool keeps in a slot, and
# gives a `Stamped[T]`: the entity's address and its slot's generation, a U64 (16 bytes on a 64-bit target).
# `stamp.fetch()` gives the entity's `@T`, or throws `StaleStampError` once the entity has ended.
# `pool.remove(stamp)` ends the entity right there: the slot's generation goes up, so every later `fetch` of any stamp
# of it fails, then the entity's destruct runs and the slot is free for the next `add`. A view fetched before the
# `remove` must not be used after it, which the build checks: a `remove` ends the views of T fetched before it, and
# those of every type T's destruct may remove. Views of other types stay usable. A call through a routine value may end
# entities of any type, so it ends every view fetched before.
#
# A pool is an entity the program holds, as a local or anywhere else: `pool: &StampManager[Node] <- .construct(manager:
# HEAP)`. Ending it (`drop pool`, or the builder's drop at the end of its scope) makes every stamp of it stale, then
# destructs the entities left in it, and it ends the views the same way a remove does. A stamp names its pool too: its
# slot's page names the slot store, which is the pool's. The pool's slot store (SlotStore.lpa) never frees its pages,
# so a fetch of a stale stamp, even one whose pool has ended, always reads a generation that isn't the stamp's. A link
# that may be missing is a `Stamped[T]?`: a `@none_is_zero` record, so it is the stamp itself and the all-zero
# stamp is None.
#
# A pool belongs to one thread, like a global the program changes: the build refuses a routine that a work runs on
# another thread to make one, add to it, fetch from it, remove from it or end it (see the thread rule in LAPILA-FOR-AI.md).

module System/Memory

### A link to an entity in a StampManager: the entity's address and its slot's generation when the entity was added.
### The stamp doesn't keep the entity alive and copies for free. `fetch()` reads the entity while its slot has this
### generation. Two stamps are equal when they name the same entity, and a stamp hashes by the entity it names, so a
### `Set[Stamped[T]]` keeps the entities seen. A link that may be missing is a `Stamped[T]?`, which is this record alone
### with the all-zero record as None.
### :typeparam T: The entity's type.
@none_is_zero
@entity_link
@target(os: not "none")
record Stamped[T]
obeys Equatable[Stamped[T]], Hashable[Stamped[T]]
    ### The entity's address, never zero.
    secret at: Addr
    ### The slot's generation when the entity was added, always odd.
    secret generation: U64

### A pool of entities of type T, which the program holds and ends: `pool: &StampManager[Node] <- .construct(manager:
### HEAP)`. Ending it makes every stamp of it stale and destructs the entities left.
### :typeparam T: The entities' type.
@target(os: not "none")
entity StampManager[T]
    ### The pool's slot store, which stays where it is when the pool moves: the stamps' pages name it.
    secret store: Addr
    ### Where the pool's slot store comes from.
    secret memory: @MemoryManager

### A stamp whose entity was removed from its pool, or whose pool has ended.
crashable StaleStampError
    nothing

### Makes an empty pool.
### :typeparam T: The entities' type.
### :param manager: Where the pool's slot store comes from.
### :returns: The pool.
### :throws: Throws `OutOfMemoryError` when the manager has no memory for the slot store.
@uses_pool
@target(os: not "none")
common routine StampManager[T].construct(manager: @MemoryManager) -> Me
    store: Addr = allocate[SlotStore](count: 1, manager)
    if store.is_hollow()
        throw OutOfMemoryError()
    store.to[@SlotStore]().zeroinit(1)
    return Me(store, memory: manager)

### Writes `The entity this stamp names was removed from its pool, or the pool has ended.`
### :typeparam TWriter: The Writer's type.
### :param out: Where it goes.
routine StaleStampError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("The entity this stamp names was removed from its pool, or the pool has ended.")
    return

### Hands `value` to the pool, which keeps it in a slot from now on, and gives its stamp.
### :typeparam T: The entities' type.
### :param value: The entity, handed over.
### :returns: The stamp.
### :throws: Throws `OutOfMemoryError` when there is no memory for a new page of slots. Throws `UnacceptedValueError` for a type aligned past 16 bytes. The value ends before the failure goes on.
@uses_pool
@keeps(value)
@target(os: not "none")
routine @StampManager[T].add(value: T) -> Stamped[T]
    if alignof[T]() > 16
        drop value
        throw UnacceptedValueError(description: "A StampManager keeps types aligned to at most 16 bytes.")
    at: Addr = me.store.peek().to[@SlotStore]().take(sizeof[T]())
    if at.is_hollow()
        drop value
        throw OutOfMemoryError()
    at.to[@T]().poke(steal value)
    return Stamped[T](at, generation: SlotStore.generation_of(at).peek())

### The entity the stamp was added with, in its slot.
### :typeparam T: The entity's type.
### :returns: The entity's view.
### :throws: `StaleStampError` when the entity was removed, or its pool has ended.
@inline
@uses_pool
@target(os: not "none")
routine Stamped[T].fetch() -> @T
needs AnyType T
    if SlotStore.generation_of(me.at).peek() != me.generation
        throw StaleStampError()
    return me.at.to[@T]()

### Whether two stamps name the same entity, the same address and generation: `a === b`.
### :typeparam T: The entity's type.
### :param other: The other stamp.
### :returns: True for the same entity.
@target(os: not "none")
routine Stamped[T].same(other: Me) -> Bool
    return me.at === other.at and me.generation == other.generation

### Whether two stamps name different entities: `a !== b`.
### :typeparam T: The entity's type.
### :param other: The other stamp.
### :returns: True when the address or the generation differs.
@target(os: not "none")
routine Stamped[T].notsame(other: Me) -> Bool
    return not me.same(other)

### Whether two stamps name the same entity, as `===` does: `a == b`.
### :typeparam T: The entity's type.
### :param other: The other stamp.
### :returns: True for the same entity.
@target(os: not "none")
routine Stamped[T].eq(other: Me) -> Bool
    return me.same(other)

### The hash of the entity the stamp names: its address and generation, so stamps of one entity hash the same.
### :typeparam T: The entity's type.
### :returns: The hash.
@target(os: not "none")
routine Stamped[T].hash() -> U64
    return hash_combine(first: ptrtoint[Addr, U64](me.at), second: me.generation)

### Ends the entity of a stamp, right there: every `fetch` of its stamps fails from now on, its destruct runs, and its
### slot is free for the next entity. A view of T fetched before (or of a type T's destruct may remove) must not be used
### after this, which the build checks.
### :typeparam T: The entities' type.
### :param stamp: The entity's stamp.
### :throws: `StaleStampError` when the entity was removed already. Throws `UnacceptedValueError` when the stamp is of another pool of T: its entity stays.
@uses_pool
@ends_stamped
@target(os: not "none")
routine @StampManager[T].remove(stamp: Stamped[T]) -> None
    if SlotStore.generation_of(stamp.at).peek() != stamp.generation
        throw StaleStampError()
    if bitcast[@SlotStore, Addr](SlotStore.store_of(stamp.at)) !== me.store.peek()
        throw UnacceptedValueError(description: "This stamp is of another StampManager: remove it from the pool it was added to.")
    SlotStore.end(stamp.at)
    drop stamp.at.to[@T]()
    SlotStore.give_back(stamp.at)
    return

### How many entities the pool keeps.
### :typeparam T: The entities' type.
### :returns: The count.
@uses_pool
@target(os: not "none")
routine @StampManager[T].count() -> U64
    return me.store.peek().to[@SlotStore]().count()

### Ends the pool: makes every stamp of it stale first (the generation of each entity's slot goes up, so a destruct that
### fetches another entity of the pool always sees it ended, whatever the order), then destructs the entities left and
### puts the slots' pages on the spare list.
### :typeparam T: The entities' type.
@uses_pool
@ends_stamped
@target(os: not "none")
routine @StampManager[T].destruct() -> None
    if me.store.peek().is_hollow()
        return
    memory: @MemoryManager = me.memory.peek()
    store: @SlotStore = me.store.peek().to[@SlotStore]()
    total: U64 = store.count()
    if total > 0
        boxes: Addr = allocate[Addr](count: total, manager: memory)
        if boxes.is_hollow()
            throw OutOfMemoryError()
        ended: U64 = store.end_each(out: boxes.to[@Addr]())
        for i in 0 til ended
            box: Addr = boxes.to[@Addr]().stride(i).peek()
            drop box.to[@T]()
            SlotStore.give_back(box)
        deallocate(boxes.to[@Addr](), manager: memory)
    store.end_all()
    deallocate(store, manager: memory)
    me.store.poke(Addr.zero())
    return
