# Lapila stdlib: the heap managers
#
# Two managers of the C library's heap, both HeapManageable (MemoryManager.lpa): HeapManagerByC is malloc, realloc, and
# free with nothing in front of the blocks, for memory that C code frees or reallocates, or that comes from C's malloc,
# and HeapManagerByCheckedHeap keeps a header in front of each block and crashes on a block freed twice. HEAP (built in
# MemoryManager.lpa, with the table's fields) is the default heap, ready before start runs: the checked one with the heap
# check on (config.toml's [debug] heap-check, in any build mode), else the C library's. C_HEAP is HeapManagerByC's table
# in every build. Every routine that borrows memory takes the MemoryManager it borrows from, so these are the hosted
# tables, not a requirement.

module System/Memory

### The alignment malloc gives every block: twice a pointer's size (8 on 32-bit targets, 16 on 64-bit ones).
@target(os: not "none")
secret preset MALLOC_ALIGN: U64 = sizeof[Addr]().mul(2)

### The C library's heap: malloc, realloc, and free in every build, with nothing in front of the blocks. For memory
### that C code frees or reallocates, or that comes from C's malloc and is freed here. An alignment past malloc's own
### comes from posix_memalign (still freed with free), and on Windows, whose free can't take such a block, it crashes.
### `C_HEAP` is its table.
@target(os: not ("none", "wasip1"))
entity HeapManagerByC
obeys HeapManageable[HeapManagerByC]
    nothing

### The C library's heap through `_aligned_malloc`, so every alignment is there: the default heap on Windows with the
### heap check off. Its blocks go back through `_aligned_free`, never C's free.
@target(os: "windows")
entity HeapManagerByCAligned
obeys HeapManageable[HeapManagerByCAligned]
    nothing

### Makes the manager. It holds no values.
### :returns: The manager.
@target(os: not ("none", "wasip1"))
common routine HeapManagerByC.construct() -> Me
    return Me()

### Makes the manager. It holds no values.
### :returns: The manager.
@target(os: "windows")
common routine HeapManagerByCAligned.construct() -> Me
    return Me()

### Whether C's heap can be asked for `size` bytes at all. On a 32-bit target a size of 4 GiB or more doesn't fit
### C's size_t, and a heap turns it down as having no room instead of crashing on the conversion.
### :param size: The number of bytes.
### :returns: True when `size` fits C's size_t.
@target(os: not "none")
secret routine fits_c_size(size: U64) -> Bool
    return size <= CSize.MAX.to[U64]()

### Binds the C `malloc` function, which allocates a block of memory.
### :param size: The number of bytes.
### :returns: The new block, or null when the allocation fails.
@external("c")
@symbol("malloc")
@target(os: not ("none", "wasip1"))
secret routine c_malloc(size: CSize) -> Addr

### Binds the C `realloc` function, which resizes a block, keeping its contents up to the smaller size.
### :param ptr: The block to resize, or null for a new one.
### :param size: The new size in bytes.
### :returns: The resized block (possibly moved), or null when the allocation fails and `ptr` is untouched.
@external("c")
@symbol("realloc")
@target(os: not ("none", "wasip1"))
secret routine c_realloc(ptr: Addr, size: CSize) -> Addr

### Binds the C `free` function, which gives a block back to the C heap.
### :param ptr: The block to free. Null does nothing.
@external("c")
@symbol("free")
@target(os: not ("none", "wasip1"))
secret routine c_free(ptr: Addr) -> None

### Binds the C `posix_memalign` function, which allocates a block aligned past malloc's own alignment.
### :param out: Where the block goes.
### :param align: The alignment, a power of two and a multiple of a pointer's size.
### :param size: The number of bytes.
### :returns: 0, or an error number when the block can't be allocated.
@external("c")
@symbol("posix_memalign")
@target(os: ("linux", "macos"))
secret routine c_posix_memalign(out: @Addr, align: CSize, size: CSize) -> CInt

### Binds glibc's `malloc_usable_size`, the size a malloc block holds.
### :param ptr: The block.
### :returns: The bytes the block holds, at least its size.
@external("c")
@symbol("malloc_usable_size")
@target(os: "linux")
secret routine c_block_size(ptr: Addr) -> CSize

### Binds macOS's `malloc_size`, the size a malloc block holds.
### :param ptr: The block.
### :returns: The bytes the block holds, at least its size.
@external("c")
@symbol("malloc_size")
@target(os: "macos")
secret routine c_block_size(ptr: Addr) -> CSize

### Binds the C runtime's `_aligned_malloc`, an aligned block that `_aligned_free` gives back.
### :param size: The number of bytes.
### :param align: The alignment, a power of two.
### :returns: The block, or null.
@external("c")
@symbol("_aligned_malloc")
@target(os: "windows")
secret routine c_aligned_malloc(size: CSize, align: CSize) -> Addr

### Binds the C runtime's `_aligned_realloc`, which resizes an `_aligned_malloc` block keeping its alignment.
### :param ptr: The block, or null for a new one.
### :param size: The new size in bytes.
### :param align: The block's alignment.
### :returns: The resized block, or null with the old one untouched.
@external("c")
@symbol("_aligned_realloc")
@target(os: "windows")
secret routine c_aligned_realloc(ptr: Addr, size: CSize, align: CSize) -> Addr

### Binds the C runtime's `_aligned_free`, which gives an `_aligned_malloc` block back.
### :param ptr: The block. Null does nothing.
@external("c")
@symbol("_aligned_free")
@target(os: "windows")
secret routine c_aligned_free(ptr: Addr) -> None

### Allocates `size` bytes with malloc, or with posix_memalign for an alignment past malloc's.
### :param size: The number of bytes.
### :param align: The alignment, a power of two.
### :returns: The new block, null when the heap has no room.
@target(os: ("linux", "macos"))
routine @HeapManagerByC.borrow(size: U64, align: U64) -> Addr
    if not fits_c_size(size)
        return Addr.zero()
    if align <= MALLOC_ALIGN
        return c_malloc(size.to[CSize]())
    out: &Addr
    if c_posix_memalign(out, align.to[CSize](), size.to[CSize]()) != 0
        return Addr.zero()
    return out.load()

### Allocates `size` bytes with malloc. Windows' free can't take a block aligned past malloc's own.
### :param size: The number of bytes.
### :param align: The alignment, a power of two.
### :returns: The new block, null when malloc fails.
### :throws: Throws `UnacceptedValueError` when `align` is past malloc's own.
@target(os: "windows")
routine @HeapManagerByC.borrow(size: U64, align: U64) -> Addr
    if not fits_c_size(size)
        return Addr.zero()
    if align <= MALLOC_ALIGN
        return c_malloc(size.to[CSize]())
    throw UnacceptedValueError(description: "The C heap can't give a block aligned past malloc's own on Windows: use HEAP.")

### Resizes a block with realloc, and a block aligned past malloc's own through a new aligned block, the contents
### copied over.
### :param at: The block to resize, or null for a new one.
### :param size: The new size in bytes.
### :param align: The block's alignment.
### :returns: The resized block (possibly moved), null when the heap has no room and the old block is untouched.
@target(os: ("linux", "macos"))
routine @HeapManagerByC.reborrow(at: Addr, size: U64, align: U64) -> Addr
    if not fits_c_size(size)
        return Addr.zero()
    if align <= MALLOC_ALIGN
        return c_realloc(at, size.to[CSize]())
    fresh: Addr = me.borrow(size, align)
    if fresh.is_hollow()
        return Addr.zero()
    if at.is_hollow()
        return fresh
    kept: U64 = c_block_size(at).min(size.to[CSize]()).to[U64]()
    fresh.to[@Byte]().copy(src: at.to[@Byte](), count: kept)
    c_free(at)
    return fresh

### Resizes a block with realloc.
### :param at: The block to resize, or null for a new one.
### :param size: The new size in bytes.
### :param align: The block's alignment, at most malloc's own.
### :returns: The resized block (possibly moved), null when realloc fails and the old block is untouched.
@target(os: "windows")
routine @HeapManagerByC.reborrow(at: Addr, size: U64, align: U64) -> Addr
    if not fits_c_size(size)
        return Addr.zero()
    return c_realloc(at, size.to[CSize]())

### Gives a block back with free.
### :param at: The block to free. Null does nothing.
@target(os: not ("none", "wasip1"))
routine @HeapManagerByC.give_back(at: Addr) -> None
    c_free(at)
    return

### Allocates `size` bytes with `_aligned_malloc`.
### :param size: The number of bytes.
### :param align: The alignment, a power of two.
### :returns: The new block, null when the heap has no room.
@target(os: "windows")
routine @HeapManagerByCAligned.borrow(size: U64, align: U64) -> Addr
    if not fits_c_size(size)
        return Addr.zero()
    return c_aligned_malloc(size.to[CSize](), align.max(MALLOC_ALIGN).to[CSize]())

### Resizes a block with `_aligned_realloc`, keeping its alignment.
### :param at: The block to resize, or null for a new one.
### :param size: The new size in bytes.
### :param align: The block's alignment.
### :returns: The resized block, null when the heap has no room and the old block is untouched.
@target(os: "windows")
routine @HeapManagerByCAligned.reborrow(at: Addr, size: U64, align: U64) -> Addr
    if not fits_c_size(size)
        return Addr.zero()
    return c_aligned_realloc(at, size.to[CSize](), align.max(MALLOC_ALIGN).to[CSize]())

### Gives a block back with `_aligned_free`.
### :param at: The block to free. Null does nothing.
@target(os: "windows")
routine @HeapManagerByCAligned.give_back(at: Addr) -> None
    c_aligned_free(at)
    return

# -- the checked heap ---------------------------------------------------------------------------------------------
#
# With the heap check on (config.toml's [debug] heap-check, the same in every build mode) every block has a header
# right in front of it: a tag that says whether the block is live or freed, its size, and where malloc's block starts
# (the block is placed HEADER_ROOM bytes or more into it, at the alignment asked for). Freeing swaps the tag to FREED unbroken and looks at what was there:
#
# - LIVE: the first free. The block goes into a quarantine of the last QUARANTINE_SIZE freed blocks instead of back to
#   malloc, so its memory keeps saying FREED. The block it pushes out of the quarantine goes back to malloc.
# - FREED: the block was freed before, and the program crashes with DoubleFreeError at the line that freed it again
#   (memory_manager_call_place(), noted by deallocate).
# - anything else: the pointer isn't a block from this heap (or the bytes in front of it were overwritten), and the
#   program crashes with UnacceptedValueError.
#
# The swap is unbroken, so two threads freeing one block at once are caught too: exactly one of them sees LIVE. A
# second free is caught for sure while the block is in the quarantine. Once it has gone back to malloc, malloc may
# have written over the header (the free reads as "not a block": still a crash) or handed the memory out again as
# another live block (the second free then frees that one, unseen), so the quarantine keeps the window wide. A
# reallocation copies into a new block and frees the old one the same way, so a stale pointer to the old block is
# caught like any freed one. HeapManagerByCheckedHeap is there in every build, and HEAP is the checked heap when the heap
# check is on. With it off HEAP is the C library's heap above.

### The headers of the last QUARANTINE_SIZE freed blocks, held back from malloc.
@target(os: not "none")
secret global QUARANTINE: &Items[Addr, QUARANTINE_SIZE]
### The number of blocks that have gone into the quarantine, whose low bits pick the next slot.
@target(os: not "none")
secret global QUARANTINE_NEXT: &U64

### The room kept in front of a block for its header, a multiple of every alignment malloc gives.
@target(os: not "none")
secret preset HEADER_ROOM: U64 = 32
### The tag of a block that is in use.
@target(os: not "none")
secret preset LIVE: U64 = 0x7E55A11E
### The tag of a block that has been freed.
@target(os: not "none")
secret preset FREED: U64 = 0x7E55F4EE
### How many freed blocks the checked heap holds back from malloc.
@target(os: not "none")
secret preset QUARANTINE_SIZE: U64 = 256
### The mask that turns the running count of frees into a quarantine slot.
@target(os: not "none")
secret preset QUARANTINE_MASK: U64 = QUARANTINE_SIZE.sub(1)

### The checked heap: the C library's heap with a header in front of each block, which crashes with `DoubleFreeError`
### on a block freed twice and with `UnacceptedValueError` on memory that isn't one of its blocks. Every alignment is
### there. `HEAP` is its table when the heap check is on.
@target(os: not "none")
entity HeapManagerByCheckedHeap
obeys HeapManageable[HeapManagerByCheckedHeap]
    nothing

### What the checked heap keeps in front of each block.
@target(os: not "none")
secret record BlockHeader
    tag: U64
    size: U64
    raw: Addr

### A block given back a second time.
crashable DoubleFreeError
    nothing

### Makes the manager. It holds no values.
### :returns: The manager.
@target(os: not "none")
common routine HeapManagerByCheckedHeap.construct() -> Me
    return Me()

### Allocates with malloc (the page heap under WASI) the header room, `size` bytes, and room to align, the header
### tagged LIVE.
### :param size: The number of bytes.
### :param align: The alignment, a power of two.
### :returns: The block after the header, null when malloc fails or the size can't hold a header too.
@target(os: not "none")
routine @HeapManagerByCheckedHeap.borrow(size: U64, align: U64) -> Addr
    step: U64 = align.max(MALLOC_ALIGN)

    total: Optional[U64] = try size.add(HEADER_ROOM.add(step))
    when total
        is U64 as bytes =>
            raw: Addr = raw_heap_borrow(bytes)
            if raw.is_hollow()
                return Addr.zero()
            # The first address HEADER_ROOM bytes in that is a multiple of the alignment.
            lowest: U64 = ptrtoint[Addr, U64](raw) + HEADER_ROOM
            aligned: U64 = lowest + step - 1 & ~(step - 1)
            block_start: Addr = inttoptr[U64, Addr](aligned)
            header: @BlockHeader = header_of(block_start)
            header.tag.poke(LIVE)
            header.size.poke(size)
            header.raw.poke(raw)
            return block_start
        is None => return Addr.zero()

### Resizes a block: a new block, the contents copied over (as many bytes as both sizes allow), and the old block
### freed through the same checks as `free`.
### :param at: The block to resize, or null for a new one.
### :param size: The new size in bytes.
### :param align: The block's alignment.
### :returns: The new block, null when malloc fails and the old block is untouched.
### :throws: Crashes with `UnacceptedValueError` when `at` was freed already or isn't a block of this heap.
@target(os: not "none")
routine @HeapManagerByCheckedHeap.reborrow(at: Addr, size: U64, align: U64) -> Addr
    if at.is_hollow()
        return me.borrow(size, align)
    header: @BlockHeader = header_of(at)
    tag: U64 = header.tag.peek_unbroken()
    when
        tag == LIVE =>
            new_ptr: Addr = me.borrow(size, align)
            if new_ptr.is_hollow()
                return Addr.zero()
            kept: U64 = header.size.peek().min(size)
            new_ptr.to[@Byte]().copy(src: at.to[@Byte](), count: kept)
            release_block(at)
            return new_ptr
        tag == FREED => heap_crash(error: UnacceptedValueError(description: "The checked heap was asked to resize a block that was given back already."))
        else => heap_crash(error: UnacceptedValueError(description: "The checked heap was asked to resize memory that isn't a block it gave out."))

### Gives a block back: checks the block's tag and puts the block in the quarantine.
### :param at: The block to free. Null does nothing.
### :throws: Crashes with `DoubleFreeError` when the block was freed already, and with `UnacceptedValueError` when `at`
###     isn't a block of this heap.
@target(os: not "none")
routine @HeapManagerByCheckedHeap.give_back(at: Addr) -> None
    if at.is_hollow()
        return
    release_block(at)
    return

### The header in front of a block of the checked heap.
### :param block_start: The block, as the checked heap gave it out.
### :returns: The address `HEADER_ROOM` bytes before `block_start`.
@target(os: not "none")
secret routine header_of(block_start: Addr) -> @BlockHeader
    raw: Addr = block_start -% ByteSize.construct(bytes: HEADER_ROOM)
    header: @BlockHeader = raw.to[@BlockHeader]()
    return header

### Tags the block FREED and puts it in the quarantine, crashing when it was freed already or isn't a block of this
### heap. The block pushed out of the quarantine goes back to malloc.
### :param block_start: The block to release.
### :throws: Crashes with `DoubleFreeError` when the block was freed already, and with `UnacceptedValueError` when it
###     isn't a block of this heap.
@target(os: not "none")
secret routine release_block(block_start: Addr) -> None
    header: @BlockHeader = header_of(block_start)

    was: U64 = header.tag.swap_unbroken(FREED)
    when
        was == LIVE =>
            turn: U64 = QUARANTINE_NEXT.fetch_add_unbroken(1)
            slot: @Addr = QUARANTINE.getslot(turn & QUARANTINE_MASK)
            evicted: Addr = slot.swap_unbroken(header)
            if evicted.is_hollow()
                return
            raw_heap_give_back(evicted.to[@BlockHeader]().raw.peek())
            return
        was == FREED => heap_crash(error: DoubleFreeError())
        else => heap_crash(error: UnacceptedValueError(description: "The checked heap was asked to take back memory that isn't a block it lent."))

### A block of `bytes` bytes for the checked heap to put a header and a block in: from malloc.
### :param bytes: The number of bytes.
### :returns: The block, null when malloc fails or `bytes` doesn't fit C's size_t.
@target(os: not ("none", "wasip1"))
secret routine raw_heap_borrow(bytes: U64) -> Addr
    if not fits_c_size(bytes)
        return Addr.zero()
    return c_malloc(bytes.to[CSize]())

### Gives a block of `raw_heap_borrow` back to malloc.
### :param raw: The block.
@target(os: not ("none", "wasip1"))
secret routine raw_heap_give_back(raw: Addr) -> None
    c_free(raw)
    return

### A block of `bytes` bytes for the checked heap to put a header and a block in: from the page heap, as WASI has no
### malloc.
### :param bytes: The number of bytes.
### :returns: The block, null when the page heap has no room.
@target(os: "wasip1")
secret routine raw_heap_borrow(bytes: U64) -> Addr
    return PAGE_HEAP_MANAGER.borrow(size: bytes, align: MALLOC_ALIGN)

### Gives a block of `raw_heap_borrow` back to the page heap.
### :param raw: The block.
@target(os: "wasip1")
secret routine raw_heap_give_back(raw: Addr) -> None
    PAGE_HEAP_MANAGER.give_back(raw)
    return

### Crashes at the place of the deallocate or reallocate call that reached the heap, when one was noted, else at the
### heap itself.
### :typeparam E: The crashable.
### :param error: The failure, such as a `DoubleFreeError`.
### :throws: Always crashes with `error`.
@target(os: not "none")
@noreturn
secret routine heap_crash[E](error: E) -> None
needs E obeys Crashable
    when memory_manager_call_place()
        is @SourceLocation as place => crash_at(error, place)
        is None => nothing
    throw error

### Writes `This block was given back already: it was given back twice.`
### :typeparam TWriter: The type of the Writer.
### :param out: The Writer the message goes to.
routine DoubleFreeError.message_into[TWriter](out: @TWriter) -> None
needs TWriter obeys Writer
    out.write("This block was given back already: it was given back twice.")
    return

# -- WASI: the page heap ------------------------------------------------------------------------------------------
#
# A WASI program has no C library, so no malloc: its heap is HeapManagerByPages, whose memory is WebAssembly pages of
# 64 KiB that the page layer (Pages.lpa) takes from linear memory with memory.grow, the same pages PAGES lends. A block
# of 32 KiB or less comes from a page cut into blocks of one size, a power of two from 16 bytes on, which is aligned to
# its size. A larger one is a run of whole pages of its own, given back to the page layer when it is freed. A table of
# one word per page of linear memory (4 GiB holds 65536) says what each page holds: 0 nothing of the heap's, 1 to 12
# a block size, or a run's length with the top bit set. A WASI program runs on one thread, so nothing is locked.

### The first free block of each size, 16 bytes up to 32 KiB, null for none. A free block holds the next one's address.
@target(os: "wasip1")
secret global FREE_BLOCKS: &Items[Addr, 12]

### What each page of linear memory holds: 0 nothing of the heap's, a block size's number plus one, or `RUN_MARK` and
### the length of the run of pages it starts.
@target(os: "wasip1")
secret global PAGE_KINDS: &Items[U32, 65536]

### The smallest block the page heap lends, and the step its sizes double from.
@target(os: "wasip1")
secret preset SMALLEST_BLOCK: U64 = 16
### The largest block cut from a shared page: a larger one gets pages of its own.
@target(os: "wasip1")
secret preset LARGEST_SMALL_BLOCK: U64 = 32768
### A WebAssembly page: what linear memory grows by.
@target(os: "wasip1")
secret preset WASM_PAGE: U64 = 65536
### The bit of a page's table word that marks the first page of a run of pages.
@target(os: "wasip1")
secret preset RUN_MARK: U32 = 0x80000000

### The heap of a WASI program: blocks cut from WebAssembly pages the page layer takes with memory.grow. `C_HEAP` is
### its table, and `HEAP` is with the heap check off. Every alignment up to a page (64 KiB) is there.
@target(os: "wasip1")
entity HeapManagerByPages
obeys HeapManageable[HeapManagerByPages]
    nothing

### Makes the manager. It holds no values: the heap's state is the module's.
### :returns: The manager.
@target(os: "wasip1")
common routine HeapManagerByPages.construct() -> Me
    return Me()

### The number of the page an address is in.
### :param at: The address.
### :returns: The page's number, the address divided by 64 KiB.
@target(os: "wasip1")
secret routine page_number(at: Addr) -> U64
    return ptrtoint[Addr, U64](at) >> 16

### The number of the block size that holds `need` bytes: 0 for 16 bytes, 1 for 32, up to 11 for 32 KiB.
### :param need: The bytes, from 16 to 32 KiB.
### :returns: The size's number.
@target(os: "wasip1")
secret routine block_class(need: U64) -> U64
    smallest: U64 = SMALLEST_BLOCK

    until smallest << class >= need with class: U64 = 0
        continue with class: class + 1
    then
        return class

### Cuts a new page into free blocks of one size.
### :param class: The size's number.
### :returns: False when linear memory can't grow.
@target(os: "wasip1")
secret routine refill_blocks(class: U64) -> Bool
    page: Addr = pages_reserve(WASM_PAGE)

    if page.is_hollow()
        return false
    PAGE_KINDS.getslot(page_number(page)).poke((class + 1).to[U32]())
    smallest: U64 = SMALLEST_BLOCK
    size: U64 = smallest << class
    count: U64 = WASM_PAGE // size
    for i in 0 til count
        cell: Addr = page +% ByteSize.construct(bytes: i * size)
        next: Addr = when
            i + 1 < count => cell +% ByteSize.construct(bytes: size)
            else => FREE_BLOCKS.getslot(class).peek()
        cell.to[@Addr]().poke(next)
        continue
    FREE_BLOCKS.getslot(class).poke(page)
    return true

### Lends `size` bytes aligned to `align`.
### :param size: The number of bytes.
### :param align: The alignment, a power of two.
### :returns: The block, null when linear memory can't grow or `align` is past a page.
@target(os: "wasip1")
routine @HeapManagerByPages.borrow(size: U64, align: U64) -> Addr
    if align > WASM_PAGE or size > U64.MAX - WASM_PAGE
        return Addr.zero()
    need: U64 = size.max(align).max(SMALLEST_BLOCK)
    if need > LARGEST_SMALL_BLOCK
        pages: U64 = (need + WASM_PAGE - 1) // WASM_PAGE
        run: Addr = pages_reserve(pages * WASM_PAGE)
        if run.is_hollow()
            return Addr.zero()
        PAGE_KINDS.getslot(page_number(run)).poke(RUN_MARK | pages.to[U32]())
        return run
    class: U64 = block_class(need)
    head: @Addr = FREE_BLOCKS.getslot(class)
    if head.peek().is_hollow() and not refill_blocks(class)
        return Addr.zero()
    cell: Addr = head.peek()
    head.poke(cell.to[@Addr]().peek())
    return cell

### How many bytes a block of the page heap holds.
### :param at: The block.
### :returns: Its size: its block size, or its run's pages.
### :throws: Crashes with `UnacceptedValueError` when `at` isn't a block of the page heap.
@target(os: "wasip1")
secret routine page_block_size(at: Addr) -> U64
    kind: U32 = PAGE_KINDS.getslot(page_number(at)).peek()
    if kind == 0
        throw UnacceptedValueError(description: "The page heap was given memory that isn't a block it lent.")
    if (kind & RUN_MARK) != 0
        return (kind & ~RUN_MARK).to[U64]() * WASM_PAGE
    smallest: U64 = SMALLEST_BLOCK
    return smallest << (kind - 1).to[U64]()

### A block of `size` bytes with the contents copied over (as many as both sizes allow), the old one given back. A
### block that holds `size` already and would hold no smaller size stays where it is.
### :param at: The block, from this manager, or null for a new one.
### :param size: The new size in bytes.
### :param align: The block's alignment.
### :returns: The block, or null with the old one left as it was.
@target(os: "wasip1")
routine @HeapManagerByPages.reborrow(at: Addr, size: U64, align: U64) -> Addr
    if at.is_hollow()
        return me.borrow(size, align)
    have: U64 = page_block_size(at)
    need: U64 = size.max(align).max(SMALLEST_BLOCK)
    if need <= have and (have == SMALLEST_BLOCK or need > have // 2)
        return at
    fresh: Addr = me.borrow(size, align)
    if fresh.is_hollow()
        return Addr.zero()
    fresh.to[@Byte]().copy(src: at.to[@Byte](), count: have.min(size))
    me.give_back(at)
    return fresh

### Gives a block back: a small one to its size's free blocks, a run of pages to the page layer.
### :param at: The block, from this manager. Null does nothing.
### :throws: Crashes with `UnacceptedValueError` when `at` isn't a block of the page heap.
@target(os: "wasip1")
routine @HeapManagerByPages.give_back(at: Addr) -> None
    if at.is_hollow()
        return
    kind_slot: @U32 = PAGE_KINDS.getslot(page_number(at))
    kind: U32 = kind_slot.peek()
    if kind == 0
        throw UnacceptedValueError(description: "The page heap was asked to take back memory that isn't a block it lent.")
    if (kind & RUN_MARK) != 0
        kind_slot.poke(0)
        pages_release(at, size: (kind & ~RUN_MARK).to[U64]() * WASM_PAGE)
        return
    head: @Addr = FREE_BLOCKS.getslot((kind - 1).to[U64]())
    at.to[@Addr]().poke(head.peek())
    head.poke(at)
    return
