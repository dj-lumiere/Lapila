# Lapila stdlib: the soft-float routines under the C names LLVM calls
#
# On a target without an operating system there is no compiler-rt or libgcc to link, so the stdlib exports the
# routines LLVM's lowering calls there by their C names: float arithmetic, comparison, and conversion where the
# target has no floating-point unit (arm-none-eabi, riscv32-none-elf), the B16, BF16, and 128-bit integer
# conversions that x86_64 and AArch64 call too, the integer division, multiplication, and leading-zero helpers of
# cores without those instructions, and C's sqrtf / sqrt / fmodf / fmod, which LLVM calls for `B32.sqrt` and
# `frem`. 32-bit ARM calls most of them by its run-time ABI's names instead (Aeabi.lpa).
#
# Each takes and returns the types its C declaration has, so a definition here and LLVM's call agree on the
# target's calling convention whatever it is (a float in an integer register on a soft-float target, in an SSE
# register on x86_64). Each is weak, so a program's own definition, or a C library it links, wins. Each is also
# #no_builtins, so LLVM can't turn its body into a call. The bodies are System/Numerics/SoftFloat's integer routines,
# which any target can call (the hosted tests check them against the hardware).
#
# The 128-bit division and float conversion helpers are exported on hosted 32-bit targets too, whose C runtime may
# lack them (libgcc builds them only for 64-bit targets), and on 64-bit Windows, whose C runtime has none of them
# (only clang's compiler-rt does, which an in-process JIT doesn't link). A WASI program links no C library and no
# compiler-rt, so the half-float conversions, fmodf and fmod are exported there too, with the 128-bit multiply and
# shift helpers WebAssembly calls (at the end of this file). Its BF16 arithmetic needs no helper: the builder works it
# out in B32.

module System/Numerics/SoftFloat

# -- arithmetic ----------------------------------------------------------------

### `__addsf3`: B32 addition ({soft_b32_add}).
### :param a: The first operand.
### :param b: The second operand.
### :returns: The sum.
@export("__addsf3")
@no_builtins
@target(os: "none")
secret routine export_addsf3(a: B32, b: B32) -> B32
    r: B32 = .from_bits(soft_b32_add(a: a.bits(), b: b.bits()))
    return r

### `__subsf3`: B32 subtraction ({soft_b32_sub}).
### :param a: The first operand.
### :param b: The second operand.
### :returns: The difference `a - b`.
@export("__subsf3")
@no_builtins
@target(os: "none")
secret routine export_subsf3(a: B32, b: B32) -> B32
    r: B32 = .from_bits(soft_b32_sub(a: a.bits(), b: b.bits()))
    return r

### `__mulsf3`: B32 multiplication ({soft_b32_mul}).
### :param a: The first operand.
### :param b: The second operand.
### :returns: The product.
@export("__mulsf3")
@no_builtins
@target(os: "none")
secret routine export_mulsf3(a: B32, b: B32) -> B32
    r: B32 = .from_bits(soft_b32_mul(a: a.bits(), b: b.bits()))
    return r

### `__divsf3`: B32 division ({soft_b32_div}).
### :param a: The first operand.
### :param b: The second operand.
### :returns: The quotient `a / b`.
@export("__divsf3")
@no_builtins
@target(os: "none")
secret routine export_divsf3(a: B32, b: B32) -> B32
    r: B32 = .from_bits(soft_b32_div(a: a.bits(), b: b.bits()))
    return r

