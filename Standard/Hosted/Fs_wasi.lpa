# Lapila stdlib: files and the filesystem under WASI (see Fs.lpa)
#
# WASI reaches files only below the directories the runtime opened for the program before it started (wasmtime's
# `--dir`). Each call looks its path up among them (Wasi.lpa): an absolute path in the one whose name is its longest
# prefix, a relative path in the one named ".". A path below none of them fails with NotEnoughPermissionError. WASI has
# no working directory, no permission bits, no memory-mapped files and no creation times: `current_dir` fails with
# NotFoundError, `set_readonly` with NotEnoughPermissionError, `OsFileManager.storage` is a build error, and a
# Metadata's `created_ns` is None.

module Hosted

import Collections

# -- the open directories ----------------------------------------------------------------

### The names of the directories the runtime opened, in memory from C_HEAP kept for the whole run, a trailing '/' left
### out.
@target(os: "wasip1")
secret global PREOPEN_NAMES: &Items[Addr, 64]

### The length of each name in `PREOPEN_NAMES`.
@target(os: "wasip1")
secret global PREOPEN_LENGTHS: &Items[U64, 64]
### The descriptor of each directory in `PREOPEN_NAMES`.
@target(os: "wasip1")
secret global PREOPEN_FDS: &Items[U32, 64]
### How many directories `PREOPEN_NAMES` holds.
@target(os: "wasip1")
secret global PREOPEN_COUNT: &U64
### Whether the directories have been asked for.
@target(os: "wasip1")
secret global PREOPENS_READ: &Bool

### The most directories the runtime opens for a program that a path is looked up in.
@target(os: "wasip1")
secret preset MOST_PREOPENS: U64 = 64

### A path as a WASI call takes it: the open directory it is below and the rest of it, relative to that directory.
@target(os: "wasip1")
secret record WasiPath
    dir: U32
    rest: @[Byte]

### Asks the runtime once which directories it opened for the program: descriptors from 3 on, until one isn't open.
@target(os: "wasip1")
secret routine read_preopens() -> None
    if PREOPENS_READ.load()
        return
    PREOPENS_READ.store(true)
    prestat: &Items[U32, 2]

    until fd >= MOST_PREOPENS.to[U32]() + 3 with fd: U32 = 3
        error: U16 = wasi_fd_prestat_get(fd, prestat.getview().to[@U32]())
        if error == WASI_BAD_DESCRIPTOR
            break
        # A tag of 0 is a directory.
        if error != 0 or (prestat.load()[0] & 0xFF) != 0
            continue with fd: fd + 1
        length: U64 = prestat.load()[1].to[U64]()
        name: Addr = allocate[Byte](count: length.max(1), manager: C_HEAP)
        if name.is_hollow() or wasi_fd_prestat_dir_name(fd, name.to[@Byte](), length.to[U32]()) != 0
            continue with fd: fd + 1
        # "/tmp/" names the same directory as "/tmp", and "/" stays itself.
        bytes: @Byte = name.to[@Byte]()
        kept: U64 = when
            length > 1 and bytes.stride(length - 1).peek() == Byte('/') => length - 1
            else => length
        n: U64 = PREOPEN_COUNT.load()
        PREOPEN_NAMES.getslot(n).poke(name)
        PREOPEN_LENGTHS.getslot(n).poke(kept)
        PREOPEN_FDS.getslot(n).poke(fd)
        PREOPEN_COUNT.store(n + 1)
        continue with fd: fd + 1
    return

### The name of an open directory.
### :param index: Its place in `PREOPEN_NAMES`.
### :returns: A view of its name.
@target(os: "wasip1")
secret routine preopen_name(index: U64) -> @[Byte]
    return @[Byte].construct(data: PREOPEN_NAMES.getslot(index).peek().to[@Byte](),
        count: PREOPEN_LENGTHS.getslot(index).peek())

### Whether an absolute path is `name` or below it.
### :param path: The absolute path.
### :param name: An open directory's absolute name.
### :returns: True when `path` starts with `name` and a '/' or its end follows.
@target(os: "wasip1")
secret routine is_below(path: @[Byte], name: @[Byte]) -> Bool
    if name.count() == 1
        return true
    if not path.has_prefix(name)
        return false
    return path.count() == name.count() or path.byte_at(name.count()) == Byte('/').to[U8]()

### `path` without the '/' bytes it starts with, or "." when nothing is left.
### :param path: The path.
### :returns: The rest.
@target(os: "wasip1")
secret routine without_leading_slashes(path: @[Byte]) -> @[Byte]
    until start >= path.count() or path.byte_at(start) != Byte('/').to[U8]() with start: U64 = 0
        continue with start: start + 1
    then
        if start >= path.count()
            return "."
        return path.slice(start, end: path.count())

### Looks `path` up among the open directories: an absolute path in the one whose name is its longest prefix, a
### relative one in the one named "." (or "/" when there is no "." one).
### :param path: The path.
### :returns: The directory and the rest of the path below it.
### :throws: Throws `InvalidPathError` for a path that holds a NUL, `NameTooLongError` for one of `PATH_CAPACITY` bytes
###     or more, and `NotEnoughPermissionError` for one below no open directory.
@target(os: "wasip1")
secret routine wasi_path(path: @[Byte]) -> WasiPath
    if path.has("\0")
        throw InvalidPathError()
    if path.count() >= PATH_CAPACITY
        throw NameTooLongError()
    read_preopens()
    absolute: Bool = path.has_prefix("/")
    until i >= PREOPEN_COUNT.load() with i: U64 = 0, best: U64 = U64.MAX, best_length: U64 = 0
        name: @[Byte] = preopen_name(i)
        longer: Bool = best == U64.MAX or name.count() > best_length
        found: Bool = when
            absolute => name.has_prefix("/") and is_below(path, name) and longer
            else => name == "." or (name == "/" and best == U64.MAX)
        if found
            continue with i: i + 1, best: i, best_length: name.count()
        continue with i: i + 1, best: best, best_length: best_length
    then
        if best == U64.MAX
            throw NotEnoughPermissionError()
        fd: U32 = PREOPEN_FDS.getslot(best).peek()
        if not absolute
            return WasiPath(dir: fd, rest: relative_rest(path))
        # "/" is the whole path's prefix, any other name its own bytes.
        skipped: U64 = when
            best_length == 1 => 0
            else => best_length
        return WasiPath(dir: fd,
            rest: without_leading_slashes(path.slice(start: skipped, end: path.count())))

### A relative path without the "./" it may start with, or "." when nothing is left.
### :param path: The relative path.
### :returns: The rest.
@target(os: "wasip1")
secret routine relative_rest(path: @[Byte]) -> @[Byte]
    if path.has_prefix("./")
        return relative_rest(without_leading_slashes(path.slice(start: 1, end: path.count())))
    if path.is_empty()
        return "."
    return path

# -- errors ---------------------------------------------------------------------------------

### The FsError for a WASI error number.
### :param e: The error number.
### :returns: The matching FsError, `IoError` for a number with no match.
@target(os: "wasip1")
secret routine wasi_error_of(e: U16) -> FsError
    when
        e == 44 => return NotFoundError()
        e == 2 or e == 63 or e == 76 => return NotEnoughPermissionError()
        e == 20 => return AlreadyExistsError()
        e == 54 => return NotADirectoryError()
        e == 31 => return IsADirectoryError()
        e == 55 => return DirectoryNotEmptyError()
        e == 75 => return CrossDeviceError()
        e == 37 => return NameTooLongError()
        e == 28 or e == 32 or e == 25 => return InvalidPathError()
        e == 51 or e == 19 => return NotEnoughSpaceError()
        e == 69 => return ReadOnlyError()
        e == 10 or e == 74 => return BusyError()
        e == 48 => return OutOfMemoryError()
        e == 29 => return StorageFaultError()
        else => return IoError(code: 0)

### A WASI call's error number as a result: 0 is success, anything else its FsError.
### :param e: The error number.
@target(os: "wasip1")
secret routine wasi_checked(e: U16) -> None
    if e == 0
        return
    throw wasi_error_of(e)

# -- metadata ------------------------------------------------------------------------------

### The kind of a WASI `filetype`.
### :param kind: The filetype: 3 a directory, 4 a file, 7 a link.
### :returns: The FileKind.
@target(os: "wasip1")
secret routine wasi_kind(kind: U64) -> FileKind
    when
        kind == 3 => return FileKind.DIRECTORY
        kind == 4 => return FileKind.FILE
        kind == 7 => return FileKind.SYMLINK
        else => return FileKind.OTHER

### The metadata of a WASI `filestat`: WASI has no permission bits, so nothing is read-only, and no creation time.
### :param stat: The eight words of the filestat: device, inode, kind, links, size, and the three times.
### :returns: The metadata.
@target(os: "wasip1")
secret routine wasi_metadata(stat: Items[U64, 8]) -> Metadata
    return Metadata(kind: wasi_kind(stat[2] & 0xFF), size: stat[4],
        modified_ns: stat[6].to_clamp[S64](), created_ns: none, readonly: false)

### The metadata of what is at a path.
### :param path: The path.
### :param follow: True to describe what a link points at, false to describe the link itself.
### :returns: The metadata.
### :throws: Throws the reason.
@target(os: "wasip1")
secret routine wasi_path_metadata(path: @[Byte], follow: Bool) -> Metadata
    stat: &Items[U64, 8]

    at: WasiPath = wasi_path(path)
    lookup: U32 = when
        follow => 1
        else => 0
    wasi_checked(wasi_path_filestat_get(at.dir, lookup, at.rest.data, at.rest.count().to[U32](),
        stat.getview().to[@U64]()))
    return wasi_metadata(stat.load())

### path's metadata, a link followed to what it points at.
### :param path: The path to look at.
### :returns: The metadata.
### :throws: Throws the reason.
@target(os: "wasip1")
secret routine metadata(path: @[Byte]) -> Metadata
    return wasi_path_metadata(path, follow: true)

### path's metadata. A link describes itself (kind Symlink).
### :param path: The path to look at.
### :returns: The metadata.
### :throws: Throws the reason.
@target(os: "wasip1")
secret routine symlink_metadata(path: @[Byte]) -> Metadata
    return wasi_path_metadata(path, follow: false)

# -- file handles ------------------------------------------------------------------------

### An open file, from a File's open_read and the like: a Reader and a Writer. claim it, and close it when done.
@target(os: "wasip1")
record FileHandle
    fd: CInt
    failed: Bool  # a write_bytes failed (write_all reports each failure itself)
    input: Addr  # the InputBuffer that reading by line, word, or value fills, hollow until the first such read

### Makes a `FileHandle` from its fields.
### :param fd: Its `fd`.
### :param failed: Its `failed`.
### :returns: The new value.
@target(os: "wasip1")
common routine FileHandle.construct(fd: CInt, failed: Bool) -> Me
    return Me(fd, failed, input: Addr.zero())

### Releases nothing: `close` gives back the input buffer.
@target(os: "wasip1")
routine @FileHandle.destruct() -> None
    return

### A handle to no file, whose close() does nothing: the start value of a slot that a finish block closes.
### :returns: The empty handle.
@target(os: "wasip1")
common routine FileHandle.empty() -> Me
    return Me(fd: -1, failed: false, input: Addr.zero())

### Opens path in mode. Only CreateNew and CreateReplacing make a file: the other modes fail with NotFound when nothing
### is there.
### :param path: The file to open.
### :param mode: How to open it.
### :returns: The open handle.
### :throws: Throws the reason.
@target(os: "wasip1")
secret common routine FileHandle.open(path: @[Byte], mode: OpenMode) -> Me
    fd: &U32 <- 0

    at: WasiPath = wasi_path(path)
    # The oflags: 1 create, 4 exclusive, 8 truncate. The fdflags: 1 append.
    open: U16 = when mode
        OpenMode.WRITE => 8
        OpenMode.CREATE_NEW => 5
        OpenMode.CREATE_REPLACING => 9
        else => 0
    flags: U16 = when mode
        OpenMode.APPEND => 1
        else => 0
    rights: U64 = when mode
        OpenMode.READ => WASI_FILE_RIGHTS | WASI_READ_RIGHT
        OpenMode.READ_WRITE => WASI_FILE_RIGHTS | WASI_READ_RIGHT | WASI_WRITE_RIGHTS
        else => WASI_FILE_RIGHTS | WASI_WRITE_RIGHTS
    wasi_checked(wasi_path_open(at.dir, lookup: 1, path: at.rest.data,
        count: at.rest.count().to[U32](), open, base: rights, inheriting: 0, flags, fd))
    return Me(fd: fd.load().to[CInt](), failed: false, input: Addr.zero())

### One read of up to count bytes into buffer: how many, 0 at the end of the file. One call reads at most 1 GiB, and a
### read an interrupt cuts short is tried again. The bytes an input buffer holds are not counted: read_bytes is the one
### that takes them first.
### :param buffer: Where the bytes go.
### :param count: The most bytes to read.
### :returns: The count read, 0 at the end of the file.
### :throws: Throws the reason when the read fails.
@target(os: "wasip1")
@expensive("asks the operating system")
routine @FileHandle.read_some(buffer: @Byte, count: U64) -> U64
    read: &U32 <- 0

    error: U16 = wasi_read_one(me.fd.peek().to[U32](), buffer,
        count: count.min(1073741824).to[U32](), read)
    if error == 0
        return read.load().to[U64]()
    if error == WASI_INTERRUPTED
        when check me.read_some(buffer, count)
            is U64 as returned => return returned
    throw wasi_error_of(error)

### Writes up to count bytes: how many it did. One call writes at most 1 GiB, and a write an interrupt cuts short is
### tried again.
### :param data: The first byte to write.
### :param count: The most bytes to write.
### :returns: The count written.
### :throws: Throws the reason when the write fails.
@target(os: "wasip1")
secret routine @FileHandle.write_some(data: @Byte, count: U64) -> U64
    written: &U32 <- 0

    error: U16 = wasi_write_one(me.fd.peek().to[U32](), data,
        count: count.min(1073741824).to[U32](), written)
    if error == 0
        return written.load().to[U64]()
    if error == WASI_INTERRUPTED
        when check me.write_some(data, count)
            is U64 as returned => return returned
    throw wasi_error_of(error)

### Moves the runtime's position: the new one, from the start. `seek` is the one that counts the bytes an input buffer
### holds.
### :param offset: The distance to move, negative to go back.
### :param from: Where `offset` counts from.
### :returns: The new position from the start.
### :throws: Throws the reason, such as a position before the start.
@target(os: "wasip1")
@expensive("asks the operating system")
secret routine @FileHandle.seek_os(offset: S64, from: SeekFrom) -> U64
    at: &U64 <- 0

    whence: U8 = when from
        SeekFrom.START => 0
        SeekFrom.CURRENT => 1
        SeekFrom.END => 2
    wasi_checked(wasi_fd_seek(me.fd.peek().to[U32](), offset, whence, at))
    return at.load()

### The metadata of the open file.
### :returns: The metadata.
### :throws: Throws the reason when the runtime can't report it.
@target(os: "wasip1")
@expensive("asks the operating system")
routine @FileHandle.metadata() -> Metadata
    stat: &Items[U64, 8]

    wasi_checked(wasi_fd_filestat_get(me.fd.peek().to[U32](), stat.getview().to[@U64]()))
    return wasi_metadata(stat.load())

### The size of the open file in bytes.
### :returns: The size.
### :throws: Throws the reason when the runtime can't report it.
@target(os: "wasip1")
@expensive("asks the operating system")
routine @FileHandle.size() -> U64
    m: Check[Metadata] = check me.metadata()
    when m
        is Metadata as info => return info.size
        is FsError as error => throw error

### Truncates or extends (with zeros) the file to size bytes. The position stays.
### :param size: The new size in bytes.
### :throws: Throws the reason when the runtime refuses.
@target(os: "wasip1")
@expensive("asks the operating system")
routine @FileHandle.set_size(size: U64) -> None
    wasi_checked(wasi_fd_filestat_set_size(me.fd.peek().to[U32](), size))
    return

### Waits until what was written is on the storage device.
### :throws: Throws the reason when the runtime reports an error.
@target(os: "wasip1")
@expensive("asks the operating system")
routine @FileHandle.sync() -> None
    wasi_checked(wasi_fd_sync(me.fd.peek().to[U32]()))
    return

### Closes the file, gives back its input buffer, and leaves the handle empty, so a second close does nothing.
@target(os: "wasip1")
@expensive("asks the operating system")
routine @FileHandle.close() -> None
    me.release_input()
    fd: CInt = me.fd.peek()
    if fd < 0
        return
    wasi_fd_close(fd.to[U32]())
    me.fd.poke(-1)
    return

# -- directories and names -------------------------------------------------------------

### Makes the directory path (its parent must exist).
### :param path: The directory to make.
### :throws: Throws the reason, `AlreadyExistsError` when something is at `path`.
@target(os: "wasip1")
secret routine create_dir(path: @[Byte]) -> None
    at: WasiPath = wasi_path(path)

    wasi_checked(wasi_path_create_directory(at.dir, at.rest.data, at.rest.count().to[U32]()))
    return

### Removes a file (or a link), not a directory.
### :param path: The file to remove.
### :throws: Throws the reason.
@target(os: "wasip1")
secret routine remove_file(path: @[Byte]) -> None
    at: WasiPath = wasi_path(path)

    wasi_checked(wasi_path_unlink_file(at.dir, at.rest.data, at.rest.count().to[U32]()))
    return

### Removes an empty directory.
### :param path: The directory to remove.
### :throws: Throws the reason, `DirectoryNotEmptyError` when something is in it.
@target(os: "wasip1")
secret routine remove_dir(path: @[Byte]) -> None
    at: WasiPath = wasi_path(path)

    wasi_checked(wasi_path_remove_directory(at.dir, at.rest.data, at.rest.count().to[U32]()))
    return

### Renames from to to, replacing what is at to.
### :param from: The current path.
### :param to: The new path.
### :throws: Throws the reason.
@target(os: "wasip1")
secret routine rename(from: @[Byte], to: @[Byte]) -> None
    a: WasiPath = wasi_path(from)
    b: WasiPath = wasi_path(to)

    wasi_checked(wasi_path_rename(a.dir, a.rest.data, a.rest.count().to[U32](), b.dir, b.rest.data,
        b.rest.count().to[U32]()))
    return

### Renames from to to, failing with AlreadyExistsError if something is at to. WASI renames in one step only by
### replacing, so this looks first: nothing else runs in between on the program's one thread, but another program
### could slip a file in.
### :param from: The current path.
### :param to: The new path.
### :throws: Throws the reason, `AlreadyExistsError` when something is at `to`.
@target(os: "wasip1")
secret routine rename_no_replace(from: @[Byte], to: @[Byte]) -> None
    there: Optional[Metadata] = try symlink_metadata(to)
    if there.is_present()
        throw AlreadyExistsError()
    rename(from, to)
    return

### Copies from's bytes into to, which is made, or replaced when `replacing`: the bytes copied. WASI has no permission
### bits to copy.
### :param from: The file to copy.
### :param to: The file to write.
### :param replacing: Whether a file already at `to` is replaced. When false, one there fails the copy.
### :returns: The number of bytes copied.
### :throws: Throws the reason when a file can't be opened, read, or written, `AlreadyExistsError` when something is at
###     `to` and `replacing` is false. A failure once `to` is opened removes it, so no partial copy is left.
@target(os: "wasip1")
secret routine copy_file(from: @[Byte], to: @[Byte], replacing: Bool) -> U64
    src: &FileHandle <- .empty()
    dst: &FileHandle <- .empty()

    when check FileHandle.open(path: from, mode: OpenMode.READ)
        is FileHandle as f => src.store(f)
    making: OpenMode = when
        replacing => OpenMode.CREATE_REPLACING
        else => OpenMode.CREATE_NEW
    when check FileHandle.open(path: to, mode: making)
        is FileHandle as f2 => dst.store(f2)
        is FsError as error =>
            src.close()
            throw error
    copied: Check[U64] = check copy_contents(src, dst)
    src.close()
    dst.close()
    when copied
        is U64 as n => return n
        is FsError as error =>
            # `to` is opened (made or emptied) and the copy can't be finished: it goes, so no partial copy is left.
            try remove_file(to)
            throw error

### Copies src's bytes into dst, 16 KiB at a time. Neither file is closed.
### :param src: The open file to read.
### :param dst: The open file to write.
### :returns: The number of bytes copied.
### :throws: Throws the reason when a read or a write fails.
@target(os: "wasip1")
secret routine copy_contents(src: @FileHandle, dst: @FileHandle) -> U64
    buffer: &Items[Byte, 16384]

    buffer2: @Byte = buffer.getview().to[@Byte]()
    loop with total: U64 = 0
        n: U64 = when check src.read_bytes(buffer: buffer2, count: 16384)
            is U64 as got => got
        if n == 0
            return total
        when check dst.write_all(data: buffer2, count: n)
            is None => continue with total: total + n

### Changes no permission: WASI has none, so a file can't be made read-only or writable.
### :param path: The file to change.
### :param readonly: True to make it read-only, false to make it writable.
### :throws: Throws the reason nothing is at `path`, else `NotEnoughPermissionError`.
@target(os: "wasip1")
secret routine set_readonly(path: @[Byte], readonly: Bool) -> None
    when check metadata(path)
        is Metadata => throw NotEnoughPermissionError()

### Whether this program may read, write, or execute path. WASI keeps no permission bits: a file that is there can be
### read and written through the directory the runtime opened, and nothing is executed.
### :param path: The path to check.
### :param access: What to check for.
### :returns: True for reading and writing what is there, false for executing and when nothing is there.
@target(os: "wasip1")
secret routine is_accessible(path: @[Byte], access: Access) -> Bool
    if access == Access.EXECUTE
        return false
    return is_present(path)

# -- directory listings ------------------------------------------------------------------

### The size of the buffer a directory's entries are read into.
@target(os: "wasip1")
secret preset DIR_BUFFER: U64 = 4096

### The entries of a directory, "." and ".." left out, in the order the runtime gives them. claim one, open it on a
### Directory, call next until None, and close it.
@target(os: "wasip1")
record DirEmitter
    fd: CInt  # the directory's descriptor, -1 until it opens
    buffer: Items[Byte, 4096]  # entries as fd_readdir wrote them: a 24-byte dirent, then the name
    used: U64  # how many bytes of `buffer` the last fd_readdir filled
    at: U64  # where the next entry starts in `buffer`
    cookie: U64  # the d_next of the last entry taken: where the next fd_readdir starts
    name_at: U64  # where the last entry's name starts in `buffer`
    name_count: U64  # its length

### Opens the listing of the directory at path. The descriptor is -1 until the open succeeds, so close() is safe
### after a failure.
### :param path: The directory to list.
### :throws: Throws the reason.
@target(os: "wasip1")
secret routine @DirEmitter.open_path(path: @[Byte]) -> None
    fd: &U32 <- 0

    me.fd.poke(-1)
    me.used.poke(0)
    me.at.poke(0)
    me.cookie.poke(0)
    me.name_count.poke(0)
    at: WasiPath = wasi_path(path)
    # The oflags: 2, a directory.
    wasi_checked(wasi_path_open(at.dir, lookup: 1, path: at.rest.data,
        count: at.rest.count().to[U32](), open: 2, base: WASI_DIRECTORY_RIGHTS,
        inheriting: WASI_ALL_RIGHTS, flags: 0, fd))
    me.fd.poke(fd.load().to[CInt]())
    return

### A little-endian word of the buffer, at any byte.
### :param at: The byte the word starts at.
### :returns: The word.
@target(os: "wasip1")
secret routine @DirEmitter.word(at: U64) -> U64
    return me.buffer.getview()
        .to[@Byte]()
        .stride(at)
        .to[Addr]()
        .to[@U64]()
        .peek()

### Whether the whole entry at `at` is in the buffer: its dirent and its name.
### :returns: True when it is.
@target(os: "wasip1")
secret routine @DirEmitter.holds_entry() -> Bool
    at: U64 = me.at.peek()
    used: U64 = me.used.peek()
    if at + 24 > used
        return false
    return at + 24 + (me.word(at + 16) & 0xFFFFFFFF) <= used

### Reads more entries from the last one taken on.
### :returns: False at the end of the listing, or when reading it fails.
@target(os: "wasip1")
secret routine @DirEmitter.refill() -> Bool
    used: &U32 <- 0

    if wasi_fd_readdir(me.fd.peek().to[U32](), me.buffer.getview().to[@Byte](),
        DIR_BUFFER.to[U32](), me.cookie.peek(), used) != 0
        return false
    me.used.poke(used.load().to[U64]())
    me.at.poke(0)
    return me.holds_entry()

### The next entry (a failure partway reads as the end).
### :returns: The next entry, its name valid until the next call.
### :throws: Throws `AbsentValueError` at the end of the listing, or when reading it fails.
@target(os: "wasip1")
routine @DirEmitter.emit() -> DirEntry
    if not me.holds_entry()
        # A buffer that wasn't filled to its end held the last entries.
        if me.used.peek() > 0 and me.used.peek() < DIR_BUFFER and me.at.peek() >= me.used.peek()
            throw AbsentValueError()
        if not me.refill()
            throw AbsentValueError()
    at: U64 = me.at.peek()
    count: U64 = me.word(at + 16) & 0xFFFFFFFF
    kind_byte: U64 = (me.word(at + 16) >> 32) & 0xFF
    me.cookie.poke(me.word(at))
    me.at.poke(at + 24 + count)
    me.name_at.poke(at + 24)
    me.name_count.poke(count)
    name: @[Byte] = @[Byte].construct(data: me.buffer.getview().to[@Byte]().stride(at + 24), count)
    if name == "." or name == ".."
        return when check me.emit()
            is DirEntry as next => next
    # A kind of 0 (unknown) asks the metadata.
    kind: FileKind = when
        kind_byte == 0 =>
            m: Check[Metadata] = check me.entry_metadata_of(false)
            when m
                is Metadata as info =>
                    becomes info.kind
                is FsError =>
                    becomes FileKind.OTHER
        else => wasi_kind(kind_byte)
    return DirEntry(name, kind)

### The metadata of the entry next last returned, a link followed.
### :returns: The metadata.
### :throws: Throws the reason.
@target(os: "wasip1")
@expensive("asks the operating system")
routine @DirEmitter.entry_metadata() -> Metadata
    when check me.entry_metadata_of(true)
        is Metadata as returned => return returned

### The metadata of the entry next last returned, looked up in the listed directory.
### :param follow: True to describe what a link points at, false to describe the link itself.
### :returns: The metadata.
### :throws: Throws the reason.
@target(os: "wasip1")
secret routine @DirEmitter.entry_metadata_of(follow: Bool) -> Metadata
    stat: &Items[U64, 8]

    lookup: U32 = when
        follow => 1
        else => 0
    wasi_checked(wasi_path_filestat_get(me.fd.peek().to[U32](), lookup,
        me.buffer.getview().to[@Byte]().stride(me.name_at.peek()), me.name_count.peek().to[U32](),
        stat.getview().to[@U64]()))
    return wasi_metadata(stat.load())

### Closes the listing and leaves the descriptor -1, so a second close does nothing.
@target(os: "wasip1")
routine @DirEmitter.close() -> None
    fd: CInt = me.fd.peek()
    if fd < 0
        return
    wasi_fd_close(fd.to[U32]())
    me.fd.poke(-1)
    return

# -- the working directory and well-known directories -------------------------------------

### A copy of `text`, in memory from manager.
### :param text: The bytes to copy.
### :param manager: The memory manager for the copy.
### :returns: The copy.
### :throws: Throws `OutOfMemoryError` when `manager` fails.
@target(os: "wasip1")
secret routine copied_path(text: @[Byte], manager: @MemoryManager) -> BorrowedSlice[Byte]
    when check BorrowedSlice[Byte].construct(count: text.count().max(1), manager: manager)
        is BorrowedSlice[Byte] as buffer =>
            buffer.data.peek().copy(src: text.data, count: text.count())
            buffer.keep_first(text.count())
            return buffer
        is OutOfMemoryError as error => throw error

### The working directory, which WASI doesn't have: a relative path names the open directory ".".
### :param manager: The memory manager for the text.
### :returns: Never returns.
### :throws: Throws `NotFoundError`.
@target(os: "wasip1")
secret routine current_dir(manager: @MemoryManager) -> BorrowedSlice[Byte]
    throw NotFoundError()

### TMPDIR, or /tmp when it is not set or empty, in memory from manager.
### :param manager: The memory manager for the text.
### :returns: The path.
### :throws: Throws `OutOfMemoryError` when `manager` fails.
@target(os: "wasip1")
secret routine temp_dir(manager: @MemoryManager) -> BorrowedSlice[Byte]
    when env_var(name: "TMPDIR", manager)
        is BorrowedSlice[Byte] as set =>
            if set.count() > 0
                return set
            drop set
        is None => nothing
    when check copied_path(text: "/tmp", manager)
        is BorrowedSlice[Byte] as text => return text

### HOME, in memory from manager. NotFound when it isn't set or is empty.
### :param manager: The memory manager for the text.
### :returns: The path.
### :throws: Throws `NotFoundError` when HOME is not set or empty.
@target(os: "wasip1")
secret routine home_dir(manager: @MemoryManager) -> BorrowedSlice[Byte]
    when env_var(name: "HOME", manager)
        is BorrowedSlice[Byte] as set =>
            if set.count() > 0
                return set
            drop set
            throw NotFoundError()
        is None => throw NotFoundError()

### path made absolute by the text alone. WASI has no working directory, so only a path that is absolute already is.
### :param path: The path to make absolute.
### :param manager: The memory manager for the result.
### :returns: The absolute path.
### :throws: Throws `NotFoundError` for a relative path, `OutOfMemoryError` when `manager` fails.
@target(os: "wasip1")
secret routine absolute_path(path: @[Byte], manager: @MemoryManager) -> BorrowedSlice[Byte]
    if not path.has_prefix("/")
        throw NotFoundError()
    when check copied_path(text: path, manager)
        is BorrowedSlice[Byte] as returned => return returned

### The absolute path with every ".", "..", and doubled '/' taken out, and path must exist. WASI resolves the links
### itself when it opens a path, so they stay as written.
### :param path: The path to resolve.
### :param manager: The memory manager for the result.
### :returns: The resolved path.
### :throws: Throws the reason, such as `NotFoundError` (also for a relative path), `OutOfMemoryError` when `manager`
###     fails.
@target(os: "wasip1")
secret routine canonical_path(path: @[Byte], manager: @MemoryManager) -> BorrowedSlice[Byte]
    if not path.has_prefix("/")
        throw NotFoundError()
    when check metadata(path)
        is Metadata => nothing
    out: &List[Byte] <- .construct(manager)

    until start >= path.count() with start: U64 = 0
        end: U64 = name_end_from(path, start)
        part: @[Byte] = path.slice(start, end)
        if part.is_empty() or part == "."
            continue with start: end + 1
        if part == ".."
            until out.count() == 0
                last: Byte = out.remove_last()
                if last == Byte('/')
                    break
                continue
            continue with start: end + 1
        out.add_last(Byte('/'))
        for i in 0 til part.count()
            out.add_last(part.data.stride(i).peek())
            continue
        continue with start: end + 1
    if out.count() == 0
        out.add_last(Byte('/'))
    when check copied_path(text: out.getview(), manager)
        is BorrowedSlice[Byte] as returned => return returned

### Where the name that starts at `start` ends: the next '/', or the end of the path.
### :param path: The path.
### :param start: Where the name starts.
### :returns: The index of the '/' after it, or the path's length.
@target(os: "wasip1")
secret routine name_end_from(path: @[Byte], start: U64) -> U64
    until i >= path.count() or path.byte_at(i) == Byte('/').to[U8]() with i: U64 = start
        continue with i: i + 1
    then
        return i

# -- memory-mapped files -----------------------------------------------------------------

### Maps nothing: WASI maps no files into memory, so `OsFileManager.storage`, the one call that maps, is a build error
### there.
### :param path: The file.
### :param write: Unused.
### :param start: Unused.
### :param count: Unused.
### :returns: An empty storage.
@target(os: "wasip1")
secret common routine FileStorage[T].map(path: @[Byte], write: Bool, start: U64, count: U64) -> Me
needs T obeys StorageCell
    return Me.empty()

### Writes nothing back: WASI maps no files.
### :param base: The mapping's base.
### :param bytes: The mapped length.
@target(os: "wasip1")
secret routine flush_mapping(base: Addr, bytes: U64) -> None
    return

### Unmaps nothing: WASI maps no files.
### :param base: The mapping's base.
### :param bytes: The mapped length.
@target(os: "wasip1")
secret routine unmap_mapping(base: Addr, bytes: U64) -> None
    return

### Reads nothing in: WASI maps no files.
### :param base: The mapping's base.
### :param bytes: The mapped length.
@target(os: "wasip1")
secret routine prefetch_mapping(base: Addr, bytes: U64) -> None
    return

### Advises nothing: WASI maps no files.
### :param base: The mapping's base.
### :param bytes: The mapped length.
@target(os: "wasip1")
secret routine advise_sequential_mapping(base: Addr, bytes: U64) -> None
    return

# -- partitions --------------------------------------------------------------------------

### The device the file system at path is on, as the runtime numbers it.
### :param path: An existing path (a link counts as what it points at).
### :returns: The device number.
### :throws: Throws the reason when the path can't be looked at.
@target(os: "wasip1")
secret routine device_id(path: @[Byte]) -> U64
    stat: &Items[U64, 8]

    at: WasiPath = wasi_path(path)
    wasi_checked(wasi_path_filestat_get(at.dir, 1, at.rest.data, at.rest.count().to[U32](),
        stat.getview().to[@U64]()))
    return stat.load()[0]
